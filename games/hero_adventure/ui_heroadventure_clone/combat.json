{
  "id": "combat",
  "title": "Encounter: {monster_name}",
  "text": [
    "ENEMY STATS",
    "Fighting: {monster_fighting}  Defending: {monster_defending}  Magic: {monster_magic}",
    "",
    "YOUR PROFILE",
    "Attack: {combat_attack}  Defense: {combat_effective_defense}",
    "Dmg/Rnd: {combat_round_damage}  Enemy Dmg: {combat_incoming_damage}",
    "",
    "{combat_narration}",
    "",
    "ESTIMATED COMBAT",
