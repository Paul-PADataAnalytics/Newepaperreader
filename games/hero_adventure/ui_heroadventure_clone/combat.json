    { "label": "Steal ({steal_win_pct}%)", "action": "combat:steal" },
    { "label": "Kill ({stealth_kill_win_pct}%)", "action": "combat:stealth_kill" },
    { "label": "Run Away", "action": "run_away", "visible_if": "allow_run" }
